# Telegram Bot Credentials (do not commit real values)
BOT_TOKEN=
UPLOAD_TOKEN=
OWNER_ID=
GITHUB_LINK=
CHANNEL_ID=
# Telegram API configuration
# Keep blank for Telegram's hosted Bot API; set URLs for a local Bot API server.
TELEGRAM_API_BASE_URL=
TELEGRAM_FILE_BASE_URL=
MAX_TELEGRAM_DOWNLOAD_SIZE=20971520

# Google Drive Configuration
# Leave DRIVE_FOLDER_ID empty to let the bot auto-create and manage its own folder
DRIVE_FOLDER_ID=
DRIVE_FOLDER_NAME=Bot-Uploads
# Comma-separated allowed Telegram user IDs; OWNER_ID is included automatically
DRIVE_ALLOWED_USER_IDS=
# Storage usage threshold in GB before auto-cleanup deletes oldest files
DRIVE_CLEANUP_THRESHOLD_GB=14
# Maximum concurrent Drive uploads
DRIVE_MAX_CONCURRENT_UPLOADS=2
# Resumable upload chunk size in MB
DRIVE_UPLOAD_CHUNK_SIZE_MB=8

# Concurrency & Rate Limiting
MAX_CONCURRENT_DOWNLOADS=3
DOWNLOAD_RATELIMIT_KBPS=0

# YouTube / yt-dlp cookies (optional, defaults to <project_root>/cookies.txt)
YTDLP_COOKIES_FILE=
